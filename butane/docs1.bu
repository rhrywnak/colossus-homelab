variant: fcos
version: "1.5.0"

# =============================================================================
# docs1.bu — Butane config for VM-130 (Paperless-ngx) on pve-1
# =============================================================================
#
# Canonical, searchable document store for the Awad case.
# Spec:    DOCUMENTS/DESIGN/COLOSSUS_PAPERLESS_INFRASTRUCTURE_SPEC_v1.md
# Tracker: COLOSSUS_PAPERLESS_EXECUTION_TASK_TRACKER_v2.md
#
# STORAGE SPLIT — the single most important thing in this file:
#
#   /var/lib/paperless/data    LOCAL DISK   SQLite DB + tantivy index +
#                                           llm_index/ + classifier model.
#                                           SQLite over NFS CORRUPTS. Never move
#                                           this to a network mount.
#                                           (3.0 replaced Whoosh with tantivy;
#                                            the split is unchanged.)
#   /var/mnt/paperless/media   NFS ex. 14   the documents (originals + archive)
#   /var/mnt/paperless/export  NFS ex. 14   document_exporter output
#   /var/mnt/usershare         NFS ex. 13   whole user-share dataset; the
#                                           container is given only the
#                                           paperless-consume/ subdirectory
#
# Nothing irreplaceable lives on local disk: documents are on TrueNAS and the
# nightly export bundle rebuilds the DB and index.
#
# PHASE: Stage E. This file provides the VM, the mounts, and Python for Ansible.
# The container Quadlets are NOT here — they are written by the Ansible role
# colossus-ansible/roles/paperless/. See the Stage E note at the foot of this
# file for why.
#
# Transpile:
#   podman run --rm -i quay.io/coreos/butane:release --pretty --strict \
#     < docs1.bu > ../ignition/docs1.ign
#
# Stage:
#   scp ../ignition/docs1.ign root@10.10.100.3:/var/coreos/snippets/
#
# Create (via SEMAPHORE — build1 has no root SSH to the Proxmox hosts):
#   playbooks/create-vm.yml  -e @vars/vm-130-docs1.yml  --limit pve-1
# =============================================================================

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ1dOykw0BuYrBAagKc3Ra92H9fNm5Nq8mp2N46mUpD6 roman@proxima-centauri"
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO2hRW0JQ4RXDYeIScG0WbfxWaxHDGpo/A40aHw+kj+C semaphore-infra@colossus"
        # Mac — direct operator access. Spec §6.1 lists 10.10.10.83 as a
        # permitted source for port 8000; the operator needs shell access too.
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII0SXNZYe2s3+dv6MAq/3RQoNqlu7hURtiqmcKz8u+vY roman@macbook-m5"

storage:
  directories:
    # ── LOCAL DISK: application state ────────────────────────────────────
    # SQLite database, tantivy full-text index, llm_index/, classifier model.
    #
    # Owned 3002:3001 because that is what the CONTAINER runs as
    # (User=3002 / Group=3001 in the Quadlet). It is NOT a single identity
    # spanning the NFS mounts — Issue #5 ended that idea: export 13 squashes
    # to 3001 and export 14 to 3002, and mapall makes the client uid
    # irrelevant on both. This ownership matters for the LOCAL path only.
    - path: /var/lib/paperless
      mode: 0755
      user:
        id: 3002
      group:
        id: 3001
    - path: /var/lib/paperless/data
      mode: 0770
      user:
        id: 3002
      group:
        id: 3001

    # ── NFS mount targets ────────────────────────────────────────────────
    # No hyphens in leaf names: keeps systemd unit names unescaped.
    - path: /var/mnt/paperless
      mode: 0755
    - path: /var/mnt/usershare
      mode: 0755

    # Quadlet directory (Stage E)
    - path: /etc/containers/systemd
      mode: 0755

  files:
    # ── Hostname ─────────────────────────────────────────────────────────
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: docs1

    # ── Static IP via NetworkManager ─────────────────────────────────────
    # MANDATORY: both TrueNAS NFS exports (13, 14) are pinned to this IP.
    - path: /etc/NetworkManager/system-connections/ens18.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=ens18
          type=ethernet
          interface-name=ens18
          autoconnect=true

          [ipv4]
          method=manual
          addresses=10.10.100.130/24
          gateway=10.10.100.1
          dns=10.10.100.53

          [ipv6]
          method=disabled

    # ── NFS mount: Pool-1/paperless (export 14) — media + export ─────────
    # SELinux context= is MANDATORY: NFS has no xattr support, so :z/:Z on the
    # container volume fails exactly as it does on virtiofs.
    # _netdev + network-online: NFS is unreachable before the network is up.
    - path: /etc/systemd/system/var-mnt-paperless.mount
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Mount TrueNAS Pool-1/paperless (media + export)
          After=network-online.target
          Wants=network-online.target
          Before=multi-user.target

          [Mount]
          What=10.10.0.38:/mnt/Pool-1/paperless
          Where=/var/mnt/paperless
          Type=nfs4
          Options=rw,noatime,_netdev,context="system_u:object_r:container_file_t:s0"

          [Install]
          WantedBy=multi-user.target

    # ── NFS mount: Pool-1/user-share (export 13) — consume intake ────────
    # NOTE: this mounts the WHOLE user-share dataset. The container is given
    # only the paperless-consume/ subdirectory. Export 13 permits more than the
    # container is granted — deliberate, and pinned to this host only.
    - path: /etc/systemd/system/var-mnt-usershare.mount
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Mount TrueNAS Pool-1/user-share (Paperless consume intake)
          After=network-online.target
          Wants=network-online.target
          Before=multi-user.target

          [Mount]
          What=10.10.0.38:/mnt/Pool-1/user-share
          Where=/var/mnt/usershare
          Type=nfs4
          Options=rw,noatime,_netdev,context="system_u:object_r:container_file_t:s0"

          [Install]
          WantedBy=multi-user.target

    # ── Python for Ansible management ────────────────────────────────────
    # CoreOS doesn't ship Python. This layered package persists across reboots.
    #
    # MANDATORY for this host: the Paperless Quadlets are written by the
    # Ansible role roles/paperless/, and every module it uses (template, file,
    # systemd, assert) needs a Python interpreter on the target. Without this,
    # `ansible docs1 -m ping` fails with
    #     "The module interpreter '/usr/bin/python3' was not found."
    #
    # Modelled on colossus-prod-app1.bu. It was omitted here originally because
    # docs1.bu was modelled on observe.bu, which is not an Ansible target —
    # the same inheritance-of-omission that cost a rebuild in Issue #4.
    # Do not model an Ansible-managed host on observe.bu.
    #
    # Costs one extra reboot on first boot (before the Zincati update reboot).
    - path: /etc/systemd/system/install-python.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Install Python for Ansible
          After=network-online.target
          Wants=network-online.target
          ConditionPathExists=!/usr/bin/python3

          [Service]
          Type=oneshot
          ExecStart=/usr/bin/rpm-ostree install --idempotent python3
          ExecStartPost=/usr/bin/systemctl reboot

          [Install]
          WantedBy=multi-user.target

# =============================================================================
# STAGE E — container Quadlets are NOT in this file
# =============================================================================
# The four container Quadlets, the .network unit and the environment file are
# written by the ANSIBLE ROLE:
#
#     colossus-ansible/roles/paperless/
#     colossus-ansible/playbooks/deploy-paperless.yml   (hosts: docs_vms)
#
# They are deliberately NOT baked in here. Three reasons, in order of weight:
#
#   1. PAPERLESS_SECRET_KEY comes from Ansible Vault. A Quadlet baked into
#      Ignition would reference an EnvironmentFile that does not exist until
#      Ansible has run, so the container would crash-loop on first boot.
#      (authentik.bu has plaintext secrets committed — existing debt, not a
#      pattern to copy.)
#   2. Re-pinning any of four image digests would otherwise mean a full VM
#      rebuild instead of a playbook run.
#   3. The role path is the only container-deployment pattern proven on this
#      fleet — see roles/colossus-legal/.
#
# This file therefore provides exactly three things: the VM identity and
# network, the two NFS mounts + the local data directory, and Python so
# Ansible can manage the host.
#
# Constraints that live in the role, recorded here so they are not lost:
#   - Container runs NON-ROOT, User=3002 / Group=3001. Do NOT set USERMAP_UID
#     or USERMAP_GID: in root mode the image chowns the consume folder to
#     match, which SUCCEEDS over NFS and locks this client out of it
#     irrecoverably (Issue #11).
#   - /mnt vs /var/mnt asymmetry: mount units use the canonical /var/mnt path;
#     container Volume= lines use /mnt (the symlink). Quadlet's auto-generated
#     RequiresMountsFor= follows the symlink path and therefore matches
#     nothing — the role hand-writes RequiresMountsFor=/var/mnt/... as well.
#   - No :z / :Z on the NFS volumes; these mounts carry SELinux context=.
#     :Z is correct only on the local data volume.
#   - Gotenberg MUST carry (spec §4.4 — tracking pixels in opposing counsel
#     email): --chromium-disable-javascript=true
#             --chromium-allow-list=file:///tmp/.*
#   - PAPERLESS_CONSUMER_POLLING_INTERVAL=60 — note the _INTERVAL suffix; the
#     shorter name does not exist in 3.0.5 and would silently leave inotify
#     active, which is unreliable over NFS.
# =============================================================================

systemd:
  units:
    # Enable both NFS mounts. Do NOT list Quadlet .container units here —
    # they self-enable via [Install], and in any case they are written by
    # Ansible, not by this file.
    - name: var-mnt-paperless.mount
      enabled: true
    - name: var-mnt-usershare.mount
      enabled: true
    - name: install-python.service
      enabled: true
