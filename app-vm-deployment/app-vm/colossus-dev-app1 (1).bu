variant: fcos
version: "1.5.0"

# ==============================================================================
# Colossus DEV Application VM — VM-220 (colossus-dev-app1)
# ==============================================================================
# CoreOS VM running the Colossus-Legal application containers:
#   - colossus-backend  (Rust/Axum)  → port 3403
#   - colossus-frontend (React/nginx) → port 5473
#
# Both containers are pulled from ghcr.io/rhrywnak/ and managed via Quadlet
# (systemd-native container management, same pattern as the DB VMs).
#
# RUST LEARNING NOTE — Quadlet:
# Quadlet is Podman's integration with systemd. Instead of writing systemd
# .service files that call `podman run`, you write .container files that
# describe WHAT you want. The Quadlet generator automatically creates the
# systemd service. Think of it as "declarative container management" —
# similar to how Rust's type system declares intent and the compiler
# figures out the implementation.
# ==============================================================================

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        # Add your SSH public key here
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ1dOykw0BuYrBAagKc3Ra92H9fNm5Nq8mp2N46mUpD6 roman@proxima-centauri"

storage:
  # ── Directory for document PDFs (mounted into backend container) ──────────
  directories:
    - path: /var/home/core/data/documents
      mode: 0755

  files:
    # ── Network configuration (static IP) ────────────────────────────────────
    - path: /etc/NetworkManager/system-connections/ens18.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=ens18
          type=ethernet
          interface-name=ens18

          [ipv4]
          method=manual
          addresses=10.10.100.220/24
          gateway=10.10.100.1
          dns=1.1.1.1;10.10.100.53

          [ipv6]
          method=disabled

    # ── Backend environment file ─────────────────────────────────────────────
    # Secrets and configuration for the Rust backend.
    # In production, these would come from Ansible Vault.
    - path: /var/home/core/colossus/backend.env
      mode: 0600
      user:
        name: core
      contents:
        inline: |
          NEO4J_URI=bolt://10.10.100.200:7687
          NEO4J_USER=neo4j
          NEO4J_PASSWORD=Drwho2010$
          DOCUMENT_STORAGE_PATH=/data/documents
          RUST_LOG=debug
          BACKEND_PORT=3403
          CORS_ALLOWED_ORIGINS=http://10.10.100.220:5473,http://localhost:5473,https://colossus-legal-dev.cogmai.com

    # ── Frontend environment file ────────────────────────────────────────────
    - path: /var/home/core/colossus/frontend.env
      mode: 0600
      user:
        name: core
      contents:
        inline: |
          COLOSSUS_API_URL=https://colossus-legal-api-dev.cogmai.com

    # ── Backend Quadlet container definition ─────────────────────────────────
    - path: /etc/containers/systemd/colossus-backend.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Colossus-Legal Backend (Rust/Axum)
          After=network-online.target
          Wants=network-online.target

          [Container]
          Image=ghcr.io/rhrywnak/colossus-backend:v0.1.0
          ContainerName=colossus-legal-backend
          EnvironmentFile=/var/home/core/colossus/backend.env
          PublishPort=3403:3403
          Volume=/var/home/core/data/documents:/data/documents:Z
          AutoUpdate=registry

          [Service]
          Restart=always
          RestartSec=10

          [Install]
          WantedBy=multi-user.target default.target

    # ── Frontend Quadlet container definition ────────────────────────────────
    - path: /etc/containers/systemd/colossus-frontend.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Colossus-Legal Frontend (React/nginx)
          After=network-online.target colossus-backend.service
          Wants=network-online.target

          [Container]
          Image=ghcr.io/rhrywnak/colossus-frontend:v0.1.0
          ContainerName=colossus-legal-frontend
          EnvironmentFile=/var/home/core/colossus/frontend.env
          PublishPort=5473:5473
          AutoUpdate=registry

          [Service]
          Restart=always
          RestartSec=10

          [Install]
          WantedBy=multi-user.target default.target

    # ── ghcr.io authentication (for private images) ─────────────────────────
    # If your images are public, this file is not needed.
    # If private, replace GITHUB_PAT with your token.
    #- path: /var/home/core/.config/containers/auth.json
    #  mode: 0600
    #  user:
    #    name: core
    #  contents:
    #    inline: |
    #      {
    #        "auths": {
    #          "ghcr.io": {
    #            "auth": "BASE64_OF_USERNAME:PAT"
    #          }
    #        }
    #      }

    # ── Python for Ansible management ────────────────────────────────────────
    # CoreOS doesn't ship Python. This layered package persists across reboots.
    - path: /etc/systemd/system/install-python.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Install Python for Ansible
          After=network-online.target
          Wants=network-online.target
          ConditionPathExists=!/usr/bin/python3

          [Service]
          Type=oneshot
          ExecStart=/usr/bin/rpm-ostree install --idempotent python3
          ExecStartPost=/usr/bin/systemctl reboot

          [Install]
          WantedBy=multi-user.target

systemd:
  units:
    - name: install-python.service
      enabled: true
