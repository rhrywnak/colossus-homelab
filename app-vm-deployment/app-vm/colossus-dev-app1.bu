variant: fcos
version: "1.5.0"

# ==============================================================================
# Colossus DEV Application VM — VM-220 (colossus-dev-app1)
# ==============================================================================
# CoreOS VM running the Colossus-Legal application containers:
#   - colossus-backend  (Rust/Axum)  → port 3403
#   - colossus-frontend (React/nginx) → port 5473
#
# Both containers are pulled from ghcr.io/rhrywnak/ and managed via Quadlet
# (systemd-native container management, same pattern as the DB VMs).
#
# STORAGE: Legal document PDFs are stored on the Proxmox host in a ZFS dataset
# (dev-zfs/legal-docs) and mounted into the VM via virtiofs. The backend
# container mounts this at /data/documents. ONNX model cache is stored on
# a second ZFS dataset (dev-zfs/models) mounted at /data/models. This follows
# the Colossus golden rule: no persistent data inside container layers or
# VM root filesystems.
#
# SELINUX: CoreOS runs SELinux in enforcing mode. virtiofs mounts from
# a non-SELinux host (Proxmox/Debian) appear as virtiofs_t, which
# containers (container_t) cannot access. The fix is the context= mount
# option which assigns container_file_t at the VFS level.
# Do NOT use :z/:Z on Volume= lines — virtiofs lacks xattr support.
#
# IMPORTANT: On Fedora CoreOS, /mnt is a symlink to /var/mnt.
# systemd mount units require canonical paths (no symlinks), so the
# mount unit uses /var/mnt/data/legal-docs — NOT /mnt/data/legal-docs.
# Both paths resolve to the same location inside the VM.
#
# SSH KEYS: Both the operator key (roman@proxima-centauri) and the
# Semaphore automation key must be present for Ansible deploys to work
# after a VM rebuild. If either is missing, add it here and retranspile.
# ==============================================================================

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ1dOykw0BuYrBAagKc3Ra92H9fNm5Nq8mp2N46mUpD6 roman@proxima-centauri"
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO2hRW0JQ4RXDYeIScG0WbfxWaxHDGpo/A40aHw+kj+C semaphore-infra@colossus"

storage:
  files:
    # ── Network configuration (static IP) ────────────────────────────────────
    - path: /etc/NetworkManager/system-connections/ens18.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=ens18
          type=ethernet
          interface-name=ens18

          [ipv4]
          method=manual
          addresses=10.10.100.220/24
          gateway=10.10.100.1
          dns=1.1.1.1;10.10.100.53

          [ipv6]
          method=disabled

    # ── virtiofs mount unit — legal document storage ─────────────────────────
    # Mounts ZFS dataset exposed from pve-2 via Proxmox directory mapping.
    # What= must match the virtiofs tag (= directory mapping ID).
    # Where= must use canonical /var/mnt/data/ path (not /mnt/data/).
    # SELinux context= is REQUIRED for containers to access virtiofs mounts.
    - path: /etc/systemd/system/var-mnt-data-legal\x2ddocs.mount
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Mount legal documents (virtiofs from host ZFS)
          After=systemd-modules-load.service
          Before=multi-user.target

          [Mount]
          What=dev-legal-docs
          Where=/var/mnt/data/legal-docs
          Type=virtiofs
          Options=context="system_u:object_r:container_file_t:s0"

          [Install]
          WantedBy=multi-user.target

    # ── virtiofs mount unit — ONNX model cache storage ───────────────────────
    # Mounts ZFS dataset (dev-zfs/models) for fastembed/ONNX model persistence.
    # Model downloads automatically on first embed run — no files to copy.
    # Same pattern as legal-docs: ZFS → directory mapping → virtiofs → container.
    - path: /etc/systemd/system/var-mnt-data-models.mount
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Mount models virtiofs share
          After=systemd-modules-load.service
          Before=multi-user.target

          [Mount]
          What=dev-models
          Where=/var/mnt/data/models
          Type=virtiofs
          Options=context="system_u:object_r:container_file_t:s0"

          [Install]
          WantedBy=multi-user.target

    # ── Backend environment file ─────────────────────────────────────────────
    # Placeholder values — Ansible overwrites on every deploy from vault.
    # IMPORTANT: Do NOT quote values — Podman treats quotes as literal chars.
    - path: /var/home/core/colossus/backend.env
      mode: 0600
      user:
        name: core
      contents:
        inline: |
          NEO4J_URI=bolt://10.10.100.200:7687
          NEO4J_USER=neo4j
          NEO4J_PASSWORD=CHANGEME_ANSIBLE_WILL_OVERWRITE
          QDRANT_URL=http://10.10.100.200:6333
          FASTEMBED_CACHE_PATH=/data/models
          DOCUMENT_STORAGE_PATH=/data/documents
          RUST_LOG=debug
          BACKEND_PORT=3403
          CORS_ALLOWED_ORIGINS=https://colossus-legal-dev.cogmai.com

    # ── Frontend environment file ────────────────────────────────────────────
    - path: /var/home/core/colossus/frontend.env
      mode: 0600
      user:
        name: core
      contents:
        inline: |
          COLOSSUS_API_URL=https://colossus-legal-api-dev.cogmai.com

    # ── Backend Quadlet container definition ─────────────────────────────────
    # After= and Requires= ensure both virtiofs mounts are active before
    # the container starts. Image tag is a placeholder — Ansible overwrites.
    - path: /etc/containers/systemd/colossus-backend.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Colossus-Legal Backend (Rust/Axum)
          After=network-online.target var-mnt-data-legal\x2ddocs.mount var-mnt-data-models.mount
          Wants=network-online.target
          Requires=var-mnt-data-legal\x2ddocs.mount var-mnt-data-models.mount

          [Container]
          Image=ghcr.io/rhrywnak/colossus-legal-backend:v0.2.0
          ContainerName=colossus-backend
          EnvironmentFile=/var/home/core/colossus/backend.env
          PublishPort=3403:3403
          Volume=/mnt/data/legal-docs:/data/documents:rw
          Volume=/mnt/data/models:/data/models:rw

          [Service]
          Restart=always
          RestartSec=10

          [Install]
          WantedBy=multi-user.target default.target

    # ── Frontend Quadlet container definition ────────────────────────────────
    - path: /etc/containers/systemd/colossus-frontend.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Colossus-Legal Frontend (React/nginx)
          After=network-online.target
          Wants=network-online.target

          [Container]
          Image=ghcr.io/rhrywnak/colossus-legal-frontend:v0.2.0
          ContainerName=colossus-frontend
          EnvironmentFile=/var/home/core/colossus/frontend.env
          PublishPort=5473:5473

          [Service]
          Restart=always
          RestartSec=10

          [Install]
          WantedBy=multi-user.target default.target

    # ── install-python.service — required for Ansible ────────────────────────
    # CoreOS has no Python by default. This one-shot service installs it via
    # rpm-ostree on first boot so Ansible can manage the VM.
    - path: /etc/systemd/system/install-python.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Install Python3 for Ansible
          After=network-online.target
          Wants=network-online.target
          ConditionPathExists=!/usr/bin/python3

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStart=/usr/bin/rpm-ostree install --allow-inactive --idempotent python3
          ExecStartPost=/usr/bin/systemctl reboot

          [Install]
          WantedBy=multi-user.target

systemd:
  units:
    - enabled: true
      name: var-mnt-data-legal\x2ddocs.mount
    - enabled: true
      name: var-mnt-data-models.mount
    - enabled: true
      name: install-python.service
